{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "lucent-orng"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "indicators": "status",
    "scope": "cwd"
  },
  "scroll": {
    "speed": 6
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "attention": {
    "notifications": false,
    "sound": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "debug": {
    "devtools": false
  }
}
