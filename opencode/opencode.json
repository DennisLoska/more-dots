{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "opencode-mem"
  ],
  "lsp": {},
  "permission": {
    "question": "deny",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.zshrc": "deny",
      "*.zsh_history": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "rm *content_library*": "deny",
      "rm -rf *": "deny",
      "rm -r *": "deny"
    },
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/HARNESS.md",
    "~/.config/opencode/PROVIDERS.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LINEAR_API_KEY}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/dennis/work",
        "/home/dennis/content_library",
        "/tmp",
        "/run/user/1000/gvfs"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "/usr/bin/chromium"
      ],
      "enabled": true
    },
    "comfy-mcp": {
      "type": "local",
      "command": [
        "/home/dennis/.local/share/mise/installs/python/3.13.12/bin/comfy-mcp"
      ],
      "env": {
        "COMFY_BIN": "/home/dennis/.local/share/mise/installs/python/3.13.12/bin/comfy"
      },
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/dennis-loska",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive": {
          "name": "Qwen3.6 35B-A3B Uncensored",
          "limit": {
            "context": 250000,
            "output": 8192
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false
  }
}
