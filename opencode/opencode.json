{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-mem", "cc-safety-net", "./plugins/caveman/plugin.js", "superpowers@git+https://github.com/obra/superpowers.git"],
  "instructions": ["~/.claude/CLAUDE.md", "AGENTS.md"],
  "mcp": {
    "dust": {
      "type": "remote",
      "url": "http://localhost:7777/sse",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "atlassian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/sse"
      ],
      "enabled": true
    },
    "caveman-shrink": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "caveman-shrink"
      ],
      "enabled": true
    }
  },
  "permission": {
    "question": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".zshrc": "deny",
      ".zsh_history": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "printenv": "deny",
      "sudo *": "deny",
      "curl *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "less *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git *": "allow",
      "git commit *": "deny",
      "git clean *": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "gh *": "allow",
      "gh *delete*": "deny",
      "gh *DELETE*": "deny",
      "gh *Delete*": "deny",
      "gh org *": "deny",
      "gh secret *": "deny",
      "sed *": "allow",
      "sort *": "allow",
      "true *": "allow",
      "printf *": "allow",
      "xargs *": "allow",
      "jq *": "allow",
      "pwd": "allow",
      "grep *": "allow",
      "npm *": "allow",
      "npm install *": "ask",
      "npx *": "allow",
      "npx install *": "ask",
      "bun *": "allow",
      "bun add *": "ask",
      "bunx install *": "ask",
      "timeout *": "allow",
      "lsof *": "allow",
      "wc *": "allow",
      "python *": "allow",
      "go *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "rm *": "deny",
      "rm -rf*": "deny"
    },
    "external_directory": {
      "~/work/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "doom_loop": "ask"
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen/qwen3-vl-8b": {
          "name": "Qwn3 VL 8b"
        },
        "openai/gpt-oss-20b": {
          "name": "OpenAI GPT OSS 20b"
        },
        "nvidia/nemotron-3-nano": {
          "name": "NVIDIA Nemotron 3 Nano"
        }
      }
    }
  }
}
