{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-mem",
    "./plugins/caveman/plugin.js",
    "./plugins/opencode-loop.ts",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "lsp": {},
  "skills": {
    "paths": [
      "/home/dennis/.cache/opencode/packages/superpowers@git+https:/github.com/obra/superpowers.git/node_modules/superpowers/skills"
    ]
  },
  "permission": {
    "question": "deny",
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.zshrc": "deny",
      "*.zsh_history": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "bash": {
      "*": "allow",
      "printenv": "deny",
      "sudo *": "deny",
      "git clean *": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "git branch -d *": "deny",
      "git branch -D *": "deny",
      "git branch --delete *": "deny",
      "gh *delete*": "deny",
      "gh *DELETE*": "deny",
      "gh *Delete*": "deny",
      "gh org *": "deny",
      "gh secret *": "deny",
      "rm *": "deny",
      "rm -rf*": "deny"
    },
    "external_directory": "allow",
    "doom_loop": "deny"
  },
  "instructions": [
    "AGENTS.md",
    "~/.config/opencode/skills/caveman/SKILL.md"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LINEAR_API_KEY}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/dennis/work",
        "/home/dennis/content_library",
        "/tmp",
        "/run/user/1000/gvfs"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executablePath",
        "/usr/bin/chromium"
      ],
      "enabled": true
    },
    "comfy-mcp": {
      "type": "local",
      "command": [
        "/home/dennis/.local/share/mise/installs/python/3.13.12/bin/comfy-mcp"
      ],
      "env": {
        "COMFY_BIN": "/home/dennis/.local/share/mise/installs/python/3.13.12/bin/comfy"
      },
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/dennis-loska",
      "enabled": true,
      "oauth": {}
    }
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen3.6-35b-a3b-uncensored-hauhaucs-aggressive": {
          "name": "Qwen3.6 35B-A3B Uncensored",
          "limit": {
            "context": 250000,
            "output": 8192
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false
  },
  "agent": {
    "compaction": {
      "model": "opencode-go/muse-spark-1.2-contributor"
    }
  }
}