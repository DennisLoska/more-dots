{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-mem",
    "cc-safety-net",
    "./plugins/caveman/plugin.js",
    "./plugins/loop/plugin.js",
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "lsp": {},
  "skills": {
    "paths": [
      "/Users/dennisloska/.cache/opencode/packages/superpowers@git+https:/github.com/obra/superpowers.git/node_modules/superpowers/skills"
    ]
  },
  "permission": {
    "question": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".zshrc": "deny",
      ".zsh_history": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "lsp": "allow",
    "bash": {
      "*": "allow",
      "printenv": "deny",
      "sudo *": "deny",
      "curl *": "allow",
      "cp *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "fd *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "less *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git *": "allow",
      "git clean *": "deny",
      "git reset *": "deny",
      "git restore *": "deny",
      "gh *": "allow",
      "gh *delete*": "deny",
      "gh *DELETE*": "deny",
      "gh *Delete*": "deny",
      "gh org *": "deny",
      "gh secret *": "deny",
      "sed *": "allow",
      "sort *": "allow",
      "true *": "allow",
      "printf *": "allow",
      "xargs *": "allow",
      "jq *": "allow",
      "pwd": "allow",
      "grep *": "allow",
      "npm *": "allow",
      "npm install *": "ask",
      "npx *": "allow",
      "npx install *": "ask",
      "bun *": "allow",
      "bun add *": "ask",
      "bunx install *": "ask",
      "timeout *": "allow",
      "lsof *": "allow",
      "wc *": "allow",
      "python *": "allow",
      "go *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "rm *": "deny",
      "rm -rf*": "deny"
