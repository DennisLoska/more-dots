alias cp="cp -iv"
alias mv="mv -iv"
alias rm="rm -v"
alias c="clear"
alias up="brew update && brew outdated && brew upgrade"
alias yt="yt-dlp --cookies ../cookie.txt --download-archive download.txt --no-post-overwrites -ciwx --audio-format mp3 --output '%(title)s.%(ext)s' --yes-playlist"
alias gs="git status"
alias gp="git pull"
alias gl="git log --decorate --oneline --graph"
alias glp="git log --pretty=format:\"%s\" -n 50"
alias gb="git branch"
alias prs="gh pr list --web"
alias prv="~/scripts/pr_viewer.sh"
alias pretty="npx -y prettier@latest --write ."
alias d="cd ~/work"
alias h="cd ~"
alias neo="cd ~/.config/nvim"
alias src="source ~/.zshrc"
alias plow="cd ~ && ./scripts/tmux_garden.sh"
alias start-pg="brew services run postgresql@16"
alias stop-pg="brew services stop postgresql@16"
alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias vimdiff="git diff origin/main...HEAD"
alias cd="z"
